# Copy to .env.local and fill in. Never commit real values.
# Local stack: run `npx supabase start`, then `npx supabase status` prints the values marked "from status".

# Public URL of the app (used for redirects). Local dev/start: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase API URL. From status: "API URL" (local default http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon) key. From status: "Publishable" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret (service role) key. From status: "Secret" key. SERVER ONLY: bypasses RLS, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Postgres connection used by the app (Prisma, pg adapter). From status: "Database URL" (local default below).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct Postgres connection (no pooler) used by the Prisma CLI. Same as DATABASE_URL on the local stack.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# HMAC-SHA256 key that signs payment-gateway webhooks. You choose it; the brief's test vector uses this value.
# The same value must be exported when running gateway-sim.mjs.
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key

# Password shared by every seeded account (manager@northwind.test, ...). You choose it; submit it with your work.
# Local-stack only value: change it before ever reusing this file anywhere real.
SEED_PASSWORD=Northwind-local-2026
