# Copy to .env.local and fill in. Never commit real values.
# Local Supabase: run `supabase start`, then `supabase status` prints the values.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local stack defaults: API 54321, DB 54322, Studio 54323)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (local Supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
